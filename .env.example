# LLM para diagnóstico y zonas dinámicas — con una alcanza:
# GEMINI_API_KEY: gratis, sin tarjeta → https://aistudio.google.com/apikey
# ANTHROPIC_API_KEY: opcional, de pago — solo se usa si Gemini falla del todo
# GEMINI_MODEL: opcional y normalmente NO hace falta. El backend rota solo
# entre los pools flash gratuitos (flash-latest → 2.5-flash → 2.5-flash-lite
# → 2.0-flash); cada pool tiene su propia cuota de ~20 req/día en el free
# tier, y los resultados se cachean en Netlify Blobs (zonas 4 h, diagnóstico
# 45 min) para vivir cómodamente dentro de esa cuota.
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
# CoinMarketCap (gratis, plan Basic) para Fear&Greed y dominancia
CMC_API_KEY=

# ────────────────────────────────────────────────────────────────────────
# BOT DE EJECUCIÓN — todo desactivado por defecto
# ────────────────────────────────────────────────────────────────────────
# Sin BOT_ENABLED=true el bot analiza y registra señales pero NO opera,
# aunque se pulse "Armar" en la interfaz.
BOT_ENABLED=

# Claves de la cuenta DEMO (Binance Futures Testnet):
#   https://testnet.binancefuture.com → login con GitHub → API Key
# Son de una cuenta con saldo ficticio: no hay dinero real en juego.
BROKER_API_KEY=
BROKER_API_SECRET=

# Cuenta REAL: deshabilitada a propósito. Activarla exige poner
# BOT_ALLOW_LIVE=true y las claves _LIVE, y asumir el riesgo de dinero real.
# BOT_ALLOW_LIVE=
# BROKER_API_KEY_LIVE=
# BROKER_API_SECRET_LIVE=
