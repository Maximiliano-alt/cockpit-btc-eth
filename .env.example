# LLM para diagnóstico y zonas dinámicas — con una alcanza:
# GEMINI_API_KEY: gratis, sin tarjeta → https://aistudio.google.com/apikey
# ANTHROPIC_API_KEY: opcional, de pago — solo se usa si Gemini falla del todo
# GEMINI_MODEL: opcional y normalmente NO hace falta. El backend rota solo
# entre los pools flash gratuitos (flash-latest → 2.5-flash → 2.5-flash-lite
# → 2.0-flash); cada pool tiene su propia cuota de ~20 req/día en el free
# tier, y los resultados se cachean en Netlify Blobs (zonas 4 h, diagnóstico
# 45 min) para vivir cómodamente dentro de esa cuota.
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
# CoinMarketCap (gratis, plan Basic) para Fear&Greed y dominancia
CMC_API_KEY=
